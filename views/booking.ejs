<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book an Appointment - Hadi Medical Clinic</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/site.css">
  
  <style>
    .booking-container {
      max-width: 600px;
      margin: 2rem auto;
    }

    .step-indicator {
      display: flex;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .step-number {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e6f0ff;
      border: 2px solid #0066cc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: #0066cc;
      position: relative;
    }

    .step-number.active {
      background: #0066cc;
      color: white;
    }

    .step-number.completed {
      background: #28a745;
      color: white;
      border-color: #28a745;
    }

    .step-line {
      flex: 1;
      height: 2px;
      background: #e6f0ff;
      margin: 19px 5px 0 5px;
      position: relative;
    }

    .step-line.completed {
      background: #28a745;
    }

    .specialty-option, .doctor-option {
      cursor: pointer;
      transition: all 0.3s ease;
      border-radius: 8px;
      padding: 15px;
      border: 2px solid #e6f0ff;
      text-decoration: none;
      color: inherit;
      display: block;
      margin-bottom: 10px;
    }

    .specialty-option:hover, .doctor-option:hover {
      border-color: #0066cc;
      background: #f8f9fa;
      text-decoration: none;
      color: inherit;
    }

    .specialty-option.selected, .doctor-option.selected {
      border-color: #0066cc;
      background: #e6f0ff;
      font-weight: 600;
    }

    .time-slot {
      cursor: pointer;
      padding: 10px;
      margin: 5px;
      border: 2px solid #e6f0ff;
      border-radius: 6px;
      display: inline-block;
      transition: all 0.3s ease;
      text-decoration: none;
      color: #333;
    }

    .time-slot:hover {
      border-color: #0066cc;
      background: #f8f9fa;
    }

    .time-slot.selected {
      border-color: #0066cc;
      background: #0066cc;
      color: white;
    }

    .form-group label {
      font-weight: 600;
      color: #0066cc;
      margin-top: 1rem;
    }

    .btn-next {
      background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
      border: none;
      padding: 10px 30px;
      font-weight: 600;
      margin-top: 1.5rem;
    }

    .btn-next:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 102, 204, 0.3);
    }

    .error-alert {
      background: #f8d7da;
      border: 1px solid #f5c6cb;
      border-radius: 8px;
      padding: 12px;
      margin-bottom: 1rem;
      color: #721c24;
    }

    .summary-card {
      background: #f8f9fa;
      border-left: 4px solid #0066cc;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 6px;
    }

    .summary-card strong {
      color: #0066cc;
    }

    .back-button {
      color: #0066cc;
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      display: inline-block;
    }

    .back-button:hover {
      text-decoration: underline;
    }

    .step-title {
      color: #0066cc;
      margin-bottom: 1.5rem;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <%- include('partials/header') %>

  <div class="container booking-container">
    <!-- Step Indicator -->
    <div class="step-indicator">
      <% for (let i = 1; i <= 4; i++) { %>
        <div class="step-number <%= i < step ? 'completed' : (i === step ? 'active' : '') %>"><%= i %></div>
        <% if (i < 4) { %>
          <div class="step-line <%= i < step ? 'completed' : '' %>"></div>
        <% } %>
      <% } %>
    </div>

    <!-- Error Messages -->
    <% if (locals.errors && errors.length > 0) { %>
      <div class="error-alert">
        <i class="bi bi-exclamation-triangle"></i>
        <ul class="mb-0 mt-2">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Summary View (Step 5) -->
    <% if (typeof showSummary !== 'undefined' && showSummary) { %>
      <h2 class="step-title"><i class="bi bi-check-circle"></i> Booking Summary</h2>
      
      <div class="summary-card">
        <strong>Specialty:</strong><br>
        <%= selectedSpecialty.name %>
      </div>

      <div class="summary-card">
        <strong>Doctor:</strong><br>
        <%= selectedSpecialty.doctor %>
      </div>

      <div class="summary-card">
        <strong>Date & Time:</strong><br>
        <% const dateObj = new Date(bookingData.date); %>
        <%= dateObj.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> at <%= bookingData.time %>
      </div>

      <div class="summary-card">
        <strong>Patient Name:</strong><br>
        <%= bookingData.patientName %>
      </div>

      <div class="summary-card">
        <strong>Email:</strong><br>
        <%= bookingData.patientEmail %>
      </div>

      <div class="summary-card">
        <strong>Phone:</strong><br>
        <%= bookingData.patientPhone %>
      </div>

      <form method="POST" action="/booking/confirm" class="mt-4">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">
        <input type="hidden" name="date" value="<%= bookingData.date %>">
        <input type="hidden" name="time" value="<%= bookingData.time %>">
        <input type="hidden" name="patientName" value="<%= bookingData.patientName %>">
        <input type="hidden" name="patientEmail" value="<%= bookingData.patientEmail %>">
        <input type="hidden" name="patientPhone" value="<%= bookingData.patientPhone %>">
        
        <a href="/booking?step=4&specialty=<%= bookingData.specialty %>&date=<%= bookingData.date %>&time=<%= bookingData.time %>&patientName=<%= encodeURIComponent(bookingData.patientName) %>&patientEmail=<%= encodeURIComponent(bookingData.patientEmail) %>&patientPhone=<%= encodeURIComponent(bookingData.patientPhone) %>" class="btn btn-outline-primary">
          <i class="bi bi-arrow-left"></i> Back
        </a>
        <button type="submit" class="btn btn-success btn-next">
          <i class="bi bi-lock"></i> Confirm &amp; Pay AED 100 Deposit
        </button>
      </form>

      <div class="alert alert-info mt-4" role="alert">
        <i class="bi bi-info-circle"></i>
        <strong>Note:</strong> To confirm your appointment, you'll pay a <strong>refundable AED 100 consultation deposit</strong> on Stripe's secure checkout page.
      </div>
    <% } %>

    <!-- Step 6: Booking Confirmation -->
    <% if (step === 6 && showConfirmation) { %>
      <div style="text-align: center; padding: 2rem 0;">
        <div style="font-size: 3rem; color: #28a745; margin-bottom: 1rem;">
          <i class="bi bi-check-circle-fill"></i>
        </div>
        <h2 class="step-title" style="color: #28a745; margin-bottom: 1rem;">Booking Confirmed!</h2>
        <p style="font-size: 1.1rem; color: #666; margin-bottom: 2rem;">
          Your deposit has been received and your appointment is confirmed.
        </p>
      </div>

      <div class="card border-success" style="max-width: 100%; margin-bottom: 2rem;">
        <div class="card-header bg-success text-white">
          <strong>Confirmation Details (Booking ID: <%= booking.id %>)</strong>
        </div>
        <div class="card-body">
          <div class="row mb-3">
            <div class="col-md-6">
              <h6 class="text-primary fw-bold">Medical Information</h6>
              <p class="mb-2">
                <strong>Specialty:</strong><br>
                <%= booking.specialty %>
              </p>
              <p class="mb-2">
                <strong>Doctor:</strong><br>
                <%= booking.doctor %>
              </p>
              <p>
                <strong>Date & Time:</strong><br>
                <% const apptDate = new Date(booking.appointmentDateTime); %>
                <%= apptDate.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                at <%= booking.appointmentDateTime.split(' ')[1] %>
              </p>
            </div>
            <div class="col-md-6">
              <h6 class="text-primary fw-bold">Your Information</h6>
              <p class="mb-2">
                <strong>Name:</strong><br>
                <%= booking.patientName %>
              </p>
              <p class="mb-2">
                <strong>Email:</strong><br>
                <%= booking.patientEmail %>
              </p>
              <p>
                <strong>Phone:</strong><br>
                <%= booking.patientPhone %>
              </p>
            </div>
          </div>

          <div class="alert alert-success mt-4" role="alert">
            <i class="bi bi-check"></i>
            <strong>Status:</strong> <%= booking.status %>
            <br>
            <strong>Deposit paid:</strong> AED 100.00 (refundable)
          </div>

          <p style="font-size: 0.9rem; color: #666; margin-top: 1.5rem;">
            <i class="bi bi-info-circle"></i>
            A confirmation email is on its way to <strong><%= booking.patientEmail %></strong>
          </p>
        </div>
      </div>

      <div style="text-align: center;">
        <a href="/" class="btn btn-primary btn-lg">
          <i class="bi bi-house"></i> Back to Home
        </a>
      </div>
    <% } %>

    <!-- Step 6: Deposit payment not completed -->
    <% if (step === 6 && locals.showPaymentIncomplete) { %>
      <div style="text-align: center; padding: 2rem 0;">
        <div style="font-size: 3rem; color: #dc3545; margin-bottom: 1rem;">
          <i class="bi bi-x-circle-fill"></i>
        </div>
        <h2 class="step-title" style="color: #dc3545; margin-bottom: 1rem;">Payment Not Completed</h2>
        <p style="font-size: 1.1rem; color: #666; margin-bottom: 2rem;">
          <% if (booking) { %>
            We have not received your AED 100 deposit, so your appointment is <strong>not confirmed yet</strong>.
            It is saved as <strong><%= booking.status %></strong> (Booking ID: <%= booking.id %>).
          <% } else { %>
            We could not find a booking for this payment, so no appointment has been confirmed.
          <% } %>
        </p>
      </div>

      <div style="text-align: center;">
        <a href="/booking" class="btn btn-primary btn-lg">
          <i class="bi bi-arrow-repeat"></i> Try Booking Again
        </a>
        <a href="/" class="btn btn-outline-primary btn-lg">
          <i class="bi bi-house"></i> Back to Home
        </a>
      </div>
    <% } %>

    <!-- Step 1: Choose Specialty -->
    <% if (step === 1 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Select Your Specialty</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="1">
        
        <% specialties.forEach(spec => { %>
          <label class="specialty-option <%= bookingData.specialty === spec.id ? 'selected' : '' %>">
            <input type="radio" name="specialty" value="<%= spec.id %>" <%= bookingData.specialty === spec.id ? 'checked' : '' %> style="display:none;">
            <strong><i class="bi bi-star"></i> <%= spec.name %></strong><br>
            <small class="text-muted"><%= spec.description %></small>
          </label>
        <% }) %>

        <button type="submit" class="btn btn-primary btn-next" style="width: 100%;">
          <i class="bi bi-arrow-right"></i> Next
        </button>
      </form>
    <% } %>

    <!-- Step 2: Choose Doctor -->
    <% if (step === 2 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Select Your Doctor</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="2">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">
        
        <label class="doctor-option selected">
          <input type="radio" name="doctor" value="<%= selectedSpecialty.doctor %>" checked style="display:none;">
          <strong><i class="bi bi-person-badge"></i> <%= selectedSpecialty.doctor %></strong><br>
          <small class="text-muted"><%= selectedSpecialty.name %> Specialist</small>
        </label>

        <div style="margin-top: 2rem;">
          <a href="/booking?step=1" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Next
          </button>
        </div>
      </form>
    <% } %>

    <!-- Step 3: Choose Date & Time -->
    <% if (step === 3 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Select Date & Time</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="3">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">

        <div class="form-group">
          <label for="date">Appointment Date</label>
          <input type="date" class="form-control" id="date" name="date" value="<%= bookingData.date || '' %>" required>
          <small class="text-muted d-block mt-2">
            <i class="bi bi-info-circle"></i> We're open Monday-Saturday. No Sundays.
          </small>
        </div>

        <div class="form-group">
          <label>Appointment Time</label>
          <div class="mt-3">
            <% timeSlots.forEach(slot => { %>
              <label class="time-slot <%= bookingData.time === slot ? 'selected' : '' %>">
                <input type="radio" name="time" value="<%= slot %>" <%= bookingData.time === slot ? 'checked' : '' %> style="display:none;">
                <small><%= slot %></small>
              </label>
            <% }) %>
          </div>
        </div>

        <div style="margin-top: 2rem;">
          <a href="/booking?step=2&specialty=<%= bookingData.specialty %>" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Next
          </button>
        </div>
      </form>
    <% } %>

    <!-- Step 4: Patient Details -->
    <% if (step === 4 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Patient Information</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="4">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">
        <input type="hidden" name="date" value="<%= bookingData.date %>">
        <input type="hidden" name="time" value="<%= bookingData.time %>">

        <div class="form-group">
          <label for="patientName">Full Name</label>
          <input type="text" class="form-control" id="patientName" name="patientName" value="<%= bookingData.patientName || '' %>" placeholder="Enter your full name" required>
        </div>

        <div class="form-group">
          <label for="patientEmail">Email Address</label>
          <input type="email" class="form-control" id="patientEmail" name="patientEmail" value="<%= bookingData.patientEmail || '' %>" placeholder="your.email@example.com" required>
        </div>

        <div class="form-group">
          <label for="patientPhone">Phone Number</label>
          <input type="tel" class="form-control" id="patientPhone" name="patientPhone" value="<%= bookingData.patientPhone || '' %>" placeholder="+971 50 123 4567" required>
        </div>

        <div style="margin-top: 2rem;">
          <a href="/booking?step=3&specialty=<%= bookingData.specialty %>&date=<%= bookingData.date %>&time=<%= bookingData.time %>" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Review Booking
          </button>
        </div>
      </form>
    <% } %>
  </div>

  <!-- Footer -->
  <%- include('partials/footer') %>

  <!-- Bootstrap 5 JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Disable Sundays and past dates in date picker
    const dateInput = document.getElementById('date');
    if (dateInput) {
      const today = new Date();
      const year = today.getFullYear();
      const month = String(today.getMonth() + 1).padStart(2, '0');
      const day = String(today.getDate()).padStart(2, '0');
      dateInput.min = `${year}-${month}-${day}`;

      dateInput.addEventListener('change', function() {
        const selectedDate = new Date(this.value);
        if (selectedDate.getDay() === 0) {
          alert('We are closed on Sundays. Please select another date.');
          this.value = '';
        }
      });
    }
  </script>
</body>
</html>
