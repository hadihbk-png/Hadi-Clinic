<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Book an Appointment - Hadi Medical Clinic</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/site.css">
  
  <style>
    .booking-container {
      max-width: 600px;
      margin: 2rem auto;
    }

    .step-indicator {
      display: flex;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .step-number {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: #e6f0ff;
      border: 2px solid #0066cc;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: #0066cc;
      position: relative;
    }

    .step-number.active {
      background: #0066cc;
      color: white;
    }

    .step-number.completed {
      background: #28a745;
      color: white;
      border-color: #28a745;
    }

    .step-line {
      flex: 1;
      height: 2px;
      background: #e6f0ff;
      margin: 19px 5px 0 5px;
      position: relative;
    }

    .step-line.completed {
      background: #28a745;
    }

    .specialty-option, .doctor-option {
      cursor: pointer;
      transition: all 0.3s ease;
      border-radius: 8px;
      padding: 15px;
      border: 2px solid #e6f0ff;
      text-decoration: none;
      color: inherit;
      display: block;
      margin-bottom: 10px;
    }

    .specialty-option:hover, .doctor-option:hover {
      border-color: #0066cc;
      background: #f8f9fa;
      text-decoration: none;
      color: inherit;
    }

    /* Highlight the choice as soon as it is tapped (not only after the next page load) */
    .specialty-option.selected, .doctor-option.selected,
    .specialty-option:has(input:checked), .doctor-option:has(input:checked) {
      border-color: #0066cc;
      background: #e6f0ff;
      font-weight: 600;
    }

    .specialty-option:has(input:focus-visible), .time-slot:has(input:focus-visible) {
      outline: 2px solid #0066cc;
      outline-offset: 2px;
    }

    .time-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
      gap: 8px;
    }

    .time-slot {
      cursor: pointer;
      min-height: 44px;
      border: 2px solid #e6f0ff;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      color: #333;
      font-variant-numeric: tabular-nums;
    }

    .time-slot:hover {
      border-color: #0066cc;
      background: #f8f9fa;
    }

    .time-slot.selected, .time-slot:has(input:checked) {
      border-color: #0066cc;
      background: #0066cc;
      color: white;
    }

    /* Back / Next row: same height; stacked full width on phones (main action on top) */
    .form-actions {
      display: flex;
      gap: 12px;
      margin-top: 2rem;
    }

    .form-actions .btn {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
    }

    .form-actions .btn-next {
      margin-top: 0;
      flex: 1;
    }

    @media (max-width: 576px) {
      .booking-container {
        margin: 1.25rem auto;
      }

      .form-actions {
        flex-direction: column-reverse;
      }

      .form-actions .btn {
        width: 100%;
      }

      .step-title {
        font-size: 1.5rem;
      }
    }

    /* Booking result pages */
    .result-banner {
      text-align: center;
      border-radius: 12px;
      padding: 2rem 1.25rem;
      margin-bottom: 1.5rem;
    }

    .result-banner:focus {
      outline: none;
    }

    .result-banner.success {
      background: #e9f7ef;
      border: 2px solid #28a745;
    }

    .result-banner.failed {
      background: #fdecea;
      border: 2px solid #dc3545;
    }

    .result-banner .result-icon {
      font-size: 3.5rem;
      line-height: 1;
    }

    .result-banner h1 {
      font-size: 1.9rem;
      font-weight: 700;
      margin: 0.75rem 0 0.5rem;
    }

    .result-banner .appointment-line {
      font-size: 1.2rem;
      font-weight: 600;
      color: #1d3b2a;
      margin-bottom: 0.25rem;
    }

    .result-banner .appointment-when {
      font-size: 1.1rem;
      color: #1d3b2a;
    }

    .detail-list {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.5rem 1rem;
      margin: 0;
    }

    .detail-list dt {
      color: #666;
      font-weight: 600;
    }

    .detail-list dd {
      margin: 0;
      overflow-wrap: anywhere;
    }

    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    @media (max-width: 576px) {
      .result-actions .btn {
        width: 100%;
      }

      .detail-list {
        grid-template-columns: 1fr;
        gap: 0.1rem;
      }

      .detail-list dd {
        margin-bottom: 0.6rem;
      }
    }

    .form-group label {
      font-weight: 600;
      color: #0066cc;
      margin-top: 1rem;
    }

    .btn-next {
      background: linear-gradient(135deg, #0066cc 0%, #0052a3 100%);
      border: none;
      padding: 10px 30px;
      font-weight: 600;
      margin-top: 1.5rem;
    }

    .btn-next:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(0, 102, 204, 0.3);
    }

    .error-alert {
      background: #f8d7da;
      border: 1px solid #f5c6cb;
      border-radius: 8px;
      padding: 12px;
      margin-bottom: 1rem;
      color: #721c24;
    }

    .summary-card {
      background: #f8f9fa;
      border-left: 4px solid #0066cc;
      padding: 15px;
      margin-bottom: 15px;
      border-radius: 6px;
    }

    .summary-card strong {
      color: #0066cc;
    }

    .back-button {
      color: #0066cc;
      text-decoration: none;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      display: inline-block;
    }

    .back-button:hover {
      text-decoration: underline;
    }

    .step-title {
      color: #0066cc;
      margin-bottom: 1.5rem;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <%- include('partials/header') %>

  <div class="container booking-container">
    <!-- Step Indicator -->
    <div class="step-indicator">
      <% for (let i = 1; i <= 4; i++) { %>
        <div class="step-number <%= i < step ? 'completed' : (i === step ? 'active' : '') %>"><%= i %></div>
        <% if (i < 4) { %>
          <div class="step-line <%= i < step ? 'completed' : '' %>"></div>
        <% } %>
      <% } %>
    </div>

    <!-- Error Messages -->
    <% if (locals.errors && errors.length > 0) { %>
      <div class="error-alert">
        <i class="bi bi-exclamation-triangle"></i>
        <ul class="mb-0 mt-2">
          <% errors.forEach(error => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- Summary View (Step 5) -->
    <% if (typeof showSummary !== 'undefined' && showSummary) { %>
      <h2 class="step-title"><i class="bi bi-check-circle"></i> Booking Summary</h2>
      
      <div class="summary-card">
        <strong>Specialty:</strong><br>
        <%= selectedSpecialty.name %>
      </div>

      <div class="summary-card">
        <strong>Doctor:</strong><br>
        <%= selectedSpecialty.doctor %>
      </div>

      <div class="summary-card">
        <strong>Date & Time:</strong><br>
        <%# YYYY-MM-DD is parsed as UTC, so format in UTC to avoid showing the day before %>
        <% const dateObj = new Date(bookingData.date); %>
        <%= dateObj.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %> at <%= bookingData.time %>
      </div>

      <div class="summary-card">
        <strong>Patient Name:</strong><br>
        <%= bookingData.patientName %>
      </div>

      <div class="summary-card">
        <strong>Email:</strong><br>
        <%= bookingData.patientEmail %>
      </div>

      <div class="summary-card">
        <strong>Phone:</strong><br>
        <%= bookingData.patientPhone %>
      </div>

      <form method="POST" action="/booking/confirm" class="mt-4">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">
        <input type="hidden" name="date" value="<%= bookingData.date %>">
        <input type="hidden" name="time" value="<%= bookingData.time %>">
        <input type="hidden" name="patientName" value="<%= bookingData.patientName %>">
        <input type="hidden" name="patientEmail" value="<%= bookingData.patientEmail %>">
        <input type="hidden" name="patientPhone" value="<%= bookingData.patientPhone %>">
        
        <div class="form-actions mt-0">
          <a href="/booking?step=4&specialty=<%= bookingData.specialty %>&date=<%= bookingData.date %>&time=<%= bookingData.time %>&patientName=<%= encodeURIComponent(bookingData.patientName) %>&patientEmail=<%= encodeURIComponent(bookingData.patientEmail) %>&patientPhone=<%= encodeURIComponent(bookingData.patientPhone) %>" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-success btn-next">
            <i class="bi bi-lock"></i> Confirm &amp; Pay AED 100 Deposit
          </button>
        </div>
      </form>

      <div class="alert alert-info mt-4" role="alert">
        <i class="bi bi-info-circle"></i>
        <strong>Note:</strong> To confirm your appointment, you'll pay a <strong>refundable AED 100 consultation deposit</strong> on Stripe's secure checkout page.
      </div>
    <% } %>

    <!-- Step 6: Booking Confirmation -->
    <% if (step === 6 && showConfirmation) { %>
      <% const [apptDay, apptTime] = booking.appointmentDateTime.split(' '); %>
      <% const [apptY, apptM, apptD] = apptDay.split('-').map(Number); %>
      <% const apptDate = new Date(Date.UTC(apptY, apptM - 1, apptD)).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }); %>

      <div class="result-banner success" id="resultBanner" role="status" tabindex="-1">
        <div class="result-icon text-success"><i class="bi bi-check-circle-fill"></i></div>
        <h1 class="text-success">You're booked!</h1>
        <p class="appointment-line"><%= booking.specialty %> with <%= booking.doctor %></p>
        <p class="appointment-when mb-3">
          <i class="bi bi-calendar-event"></i> <%= apptDate %> at <strong><%= apptTime %></strong>
        </p>
        <p class="mb-1"><i class="bi bi-check2"></i> AED 100 deposit paid (refundable)</p>
        <p class="mb-0 text-muted">Booking ID #<%= booking.id %></p>
      </div>

      <div class="alert alert-light border mb-4" role="note">
        <i class="bi bi-envelope-check"></i>
        A confirmation email is on its way to <strong style="overflow-wrap: anywhere;"><%= booking.patientEmail %></strong>.
      </div>

      <div class="card mb-4">
        <div class="card-body">
          <h2 class="h6 text-primary fw-bold mb-3">Where to go</h2>
          <dl class="detail-list">
            <dt>Clinic</dt>
            <dd>Hadi Medical Clinic, Cluster X, JLT, Dubai</dd>
            <dt>Phone</dt>
            <dd><a href="tel:+97141234567">+971 4 123 4567</a> (to change or cancel)</dd>
          </dl>

          <h2 class="h6 text-primary fw-bold mt-4 mb-3">Your details</h2>
          <dl class="detail-list">
            <dt>Name</dt>
            <dd><%= booking.patientName %></dd>
            <dt>Email</dt>
            <dd><%= booking.patientEmail %></dd>
            <dt>Phone</dt>
            <dd><%= booking.patientPhone %></dd>
            <dt>Status</dt>
            <dd><%= booking.status %></dd>
          </dl>
        </div>
      </div>

      <div class="result-actions">
        <a href="/" class="btn btn-primary btn-lg">
          <i class="bi bi-house"></i> Back to Home
        </a>
        <a href="/booking" class="btn btn-outline-primary btn-lg">
          <i class="bi bi-calendar-plus"></i> Book Another
        </a>
      </div>
    <% } %>

    <!-- Step 6: Deposit payment not completed -->
    <% if (step === 6 && locals.showPaymentIncomplete) { %>
      <div class="result-banner failed" id="resultBanner" role="alert" tabindex="-1">
        <div class="result-icon text-danger"><i class="bi bi-x-circle-fill"></i></div>
        <h1 class="text-danger">Payment Not Completed</h1>
        <p class="mb-0">
          <% if (booking) { %>
            We have not received your AED 100 deposit, so your appointment is <strong>not confirmed yet</strong>.
            It is saved as <strong><%= booking.status %></strong> (Booking ID: <%= booking.id %>).
          <% } else { %>
            We could not find a booking for this payment, so no appointment has been confirmed.
          <% } %>
        </p>
      </div>

      <div class="result-actions">
        <a href="/booking" class="btn btn-primary btn-lg">
          <i class="bi bi-arrow-repeat"></i> Try Booking Again
        </a>
        <a href="/" class="btn btn-outline-primary btn-lg">
          <i class="bi bi-house"></i> Back to Home
        </a>
      </div>
    <% } %>

    <!-- Step 1: Choose Specialty -->
    <% if (step === 1 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Select Your Specialty</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="1">
        
        <% specialties.forEach(spec => { %>
          <label class="specialty-option <%= bookingData.specialty === spec.id ? 'selected' : '' %>">
            <input type="radio" name="specialty" value="<%= spec.id %>" <%= bookingData.specialty === spec.id ? 'checked' : '' %> class="visually-hidden">
            <strong><i class="bi bi-star"></i> <%= spec.name %></strong><br>
            <small class="text-muted"><%= spec.description %></small>
          </label>
        <% }) %>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Next
          </button>
        </div>
      </form>
    <% } %>

    <!-- Step 2: Choose Doctor -->
    <% if (step === 2 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Select Your Doctor</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="2">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">
        
        <label class="doctor-option selected">
          <input type="radio" name="doctor" value="<%= selectedSpecialty.doctor %>" checked class="visually-hidden">
          <strong><i class="bi bi-person-badge"></i> <%= selectedSpecialty.doctor %></strong><br>
          <small class="text-muted"><%= selectedSpecialty.name %> Specialist</small>
        </label>

        <div class="form-actions">
          <a href="/booking?step=1" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Next
          </button>
        </div>
      </form>
    <% } %>

    <!-- Step 3: Choose Date & Time -->
    <% if (step === 3 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Select Date & Time</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="3">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">

        <div class="form-group">
          <label for="date">Appointment Date</label>
          <input type="date" class="form-control" id="date" name="date" value="<%= bookingData.date || '' %>" required>
          <small class="text-muted d-block mt-2">
            <i class="bi bi-info-circle"></i> We're open Monday-Saturday. No Sundays.
          </small>
        </div>

        <div class="form-group">
          <label>Appointment Time</label>
          <div class="mt-3 time-grid" role="radiogroup" aria-label="Appointment time">
            <% timeSlots.forEach(slot => { %>
              <label class="time-slot <%= bookingData.time === slot ? 'selected' : '' %>">
                <input type="radio" name="time" value="<%= slot %>" <%= bookingData.time === slot ? 'checked' : '' %> class="visually-hidden">
                <span><%= slot %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="form-actions">
          <a href="/booking?step=2&specialty=<%= bookingData.specialty %>" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Next
          </button>
        </div>
      </form>
    <% } %>

    <!-- Step 4: Patient Details -->
    <% if (step === 4 && (typeof showSummary === 'undefined' || !showSummary)) { %>
      <h2 class="step-title">Patient Information</h2>
      
      <form method="POST" action="/booking/submit">
        <input type="hidden" name="step" value="4">
        <input type="hidden" name="specialty" value="<%= bookingData.specialty %>">
        <input type="hidden" name="date" value="<%= bookingData.date %>">
        <input type="hidden" name="time" value="<%= bookingData.time %>">

        <div class="form-group">
          <label for="patientName">Full Name</label>
          <input type="text" class="form-control" id="patientName" name="patientName" autocomplete="name" value="<%= bookingData.patientName || '' %>" placeholder="Enter your full name" required>
        </div>

        <div class="form-group">
          <label for="patientEmail">Email Address</label>
          <input type="email" class="form-control" id="patientEmail" name="patientEmail" autocomplete="email" inputmode="email" value="<%= bookingData.patientEmail || '' %>" placeholder="your.email@example.com" required>
        </div>

        <div class="form-group">
          <label for="patientPhone">Phone Number</label>
          <input type="tel" class="form-control" id="patientPhone" name="patientPhone" autocomplete="tel" inputmode="tel" value="<%= bookingData.patientPhone || '' %>" placeholder="+971 50 123 4567" required>
        </div>

        <div class="form-actions">
          <a href="/booking?step=3&specialty=<%= bookingData.specialty %>&date=<%= bookingData.date %>&time=<%= bookingData.time %>" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Back
          </a>
          <button type="submit" class="btn btn-primary btn-next">
            <i class="bi bi-arrow-right"></i> Review Booking
          </button>
        </div>
      </form>
    <% } %>
  </div>

  <!-- Footer -->
  <%- include('partials/footer') %>


  <script>
    // Booking result: bring the success/failure message into view and announce it
    const resultBanner = document.getElementById('resultBanner');
    if (resultBanner) {
      resultBanner.focus();
    }

    // Disable Sundays and past dates in date picker
    const dateInput = document.getElementById('date');
    if (dateInput) {
      const today = new Date();
      const year = today.getFullYear();
      const month = String(today.getMonth() + 1).padStart(2, '0');
      const day = String(today.getDate()).padStart(2, '0');
      dateInput.min = `${year}-${month}-${day}`;

      dateInput.addEventListener('change', function() {
        const selectedDate = new Date(this.value);
        if (selectedDate.getUTCDay() === 0) {
          alert('We are closed on Sundays. Please select another date.');
          this.value = '';
        }
      });
    }
  </script>
</body>
</html>
