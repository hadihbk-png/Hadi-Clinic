# Copy this file to .env and fill in the values. Never commit .env.
# Stripe TEST secret key (starts with sk_test_): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Public address of this site, used for Stripe's success/cancel redirects
BASE_URL=http://localhost:3005

# SMTP server for booking confirmation emails
# Gmail example: host smtp.gmail.com, port 465, user = your Gmail address,
# pass = a Google App Password (not your normal password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address (shown as "Hadi Medical Clinic <SMTP_FROM>")
SMTP_FROM=

# Reception dashboard login (/reception, /admin/bookings). The account is created
# on startup with role "reception"; the password is stored hashed (bcrypt).
RECEPTION_EMAIL=reception@hadiclinic.local
RECEPTION_PASSWORD=

# Your name, shown in the "built by" sign-offs (site footer and emails)
BUILT_BY=

# Hosted database (Turso) - required on Vercel, optional locally (leave empty to use data/lakeside.db).
# Added automatically when you connect Turso in Vercel's Storage tab.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Chat assistant (Claude API). Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Insurers the clinic accepts, e.g. "Daman, AXA, or cash". Leave empty if unsure:
# the assistant will then say it doesn't know and suggest calling.
CLINIC_INSURANCE=
